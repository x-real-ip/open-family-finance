# Copy this file to .env and adjust the values.
POSTGRES_USER=off
POSTGRES_PASSWORD=changeme
POSTGRES_DB=open-family-finance

# Leave empty to keep the API open, or set a secret token
# (the frontend must then be built with the same VITE_API_TOKEN value).
API_TOKEN=

# UI language: "nl" (default) or "en".
LANGUAGE=nl

# Page title. Leave empty to use the default ("Open Family Finance").
APP_TITLE=

# Optional paperless-ngx integration: lets you pick a correspondent from your
# paperless instance (or type your own) on expenses, government support and
# savings entries, and shows the most recent document paperless has for it.
# Leave PAPERLESS_ENABLED unset/false to hide it entirely — PAPERLESS_URL,
# PAPERLESS_PUBLIC_URL and PAPERLESS_API_TOKEN are only used by the backend
# and never reach the browser.
PAPERLESS_ENABLED=false
# Used by the backend to call the paperless API (can be an internal/cluster URL).
PAPERLESS_URL=
# Used to build links to paperless's own web UI, so leave empty unless this
# differs from PAPERLESS_URL (e.g. PAPERLESS_URL is cluster-internal while
# paperless is reachable from your browser at a different public address).
PAPERLESS_PUBLIC_URL=
PAPERLESS_API_TOKEN=
# Optional, comma-separated document type names, in priority order — the
# linked document becomes the most recent one of the first type in this list
# that the correspondent actually has, instead of just the most recent
# overall. Leave empty to always use the most recent document of any type.
PAPERLESS_DOCUMENT_TYPE_PRIORITY=
