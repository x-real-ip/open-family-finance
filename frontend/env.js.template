// Generated at container startup from the API_TOKEN, LANGUAGE, APP_TITLE and
// PAPERLESS_ENABLED env vars. Leave API_TOKEN unset to keep the API open.
// Leave APP_TITLE unset to use the default title. PAPERLESS_ENABLED only
// toggles the UI here — the paperless URL and token live on the backend only.
window.__ENV__ = {
  API_TOKEN: "${API_TOKEN}",
  LANGUAGE: "${LANGUAGE}",
  APP_TITLE: "${APP_TITLE}",
  PAPERLESS_ENABLED: "${PAPERLESS_ENABLED}",
};
